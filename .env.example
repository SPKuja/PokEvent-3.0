# Local development defaults to SQLite. Docker Compose overrides this with PostgreSQL.
POKEVENT_DATABASE_URL=sqlite+aiosqlite:///./data/pokevent.db
POKEVENT_DISCORD_TOKEN=
POKEVENT_PUBLIC_BASE_URL=http://localhost:8080
POKEVENT_COMMUNITY_NAME=Pokémon League Swindon

# Stable Play! Pokémon League IDs -> friendly names.
POKEVENT_LEAGUES={"2012924":"Pokémon League Swindon"}

# Service-level discovery only. Guild/server configuration routes by League ID.
POKEVENT_HOME_NAME=Swindon
POKEVENT_HOME_LATITUDE=51.5615
POKEVENT_HOME_LONGITUDE=-1.7855
POKEVENT_DEFAULT_RADIUS_MILES=30

# API v2 is queried for every event type in this country/date window.
# PokEvent then applies the discovery radius locally. Configured League IDs
# are always retained even if an event is outside the discovery radius.
POKEVENT_COUNTRY_CODE=GB
POKEVENT_LOCAL_TIMEZONE=Europe/London
POKEVENT_EVENT_HORIZON_DAYS=90

POKEVENT_EVENT_SOURCE=pokedata
POKEVENT_SYNC_INTERVAL_MINUTES=180

# Docker PostgreSQL
POSTGRES_DB=pokevent
POSTGRES_USER=pokevent
POSTGRES_PASSWORD=change-me
