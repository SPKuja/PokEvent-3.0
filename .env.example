# Local development defaults to SQLite. Docker Compose overrides this with PostgreSQL.
POKEVENT_DATABASE_URL=sqlite+aiosqlite:///./data/pokevent.db
POKEVENT_DISCORD_TOKEN=
POKEVENT_PUBLIC_BASE_URL=http://localhost:8080
POKEVENT_COMMUNITY_NAME=Pokémon League Swindon
POKEVENT_BRAND_LOGO_URL=https://pokemonleagueswindon.co.uk/images/pokevent/PokEvent3.0.png

# Stable Play! Pokémon League IDs -> friendly names.
POKEVENT_LEAGUES={"2012924":"Pokémon League Swindon","5683200":"Bath TCG","6234115":"Firestorm Games Swindon","6244670":"Crazy Collectables","6238080":"Atomic Cards"}
# Optional public logos keyed by stable Play! Pokémon League ID.
POKEVENT_LEAGUE_LOGOS={"2012924":"https://pokemonleagueswindon.co.uk/images/pokevent/pokemon_league_swindon.png","5683200":"https://pokemonleagueswindon.co.uk/images/pokevent/bath_tcg.png","6234115":"https://pokemonleagueswindon.co.uk/images/pokevent/firestorm.png","6244670":"https://pokemonleagueswindon.co.uk/images/pokevent/crazy_collectables.jpg","6238080":"https://pokemonleagueswindon.co.uk/images/pokevent/atomic_cards.png"}

# Service-level discovery only. Guild/server configuration routes by League ID.
POKEVENT_HOME_NAME=Swindon
POKEVENT_HOME_LATITUDE=51.5615
POKEVENT_HOME_LONGITUDE=-1.7855
POKEVENT_DEFAULT_RADIUS_MILES=30

# API v2 is queried for every event type in this country/date window.
# PokEvent then applies the discovery radius locally. Configured League IDs
# are always retained even if an event is outside the discovery radius.
POKEVENT_COUNTRY_CODE=GB
POKEVENT_LOCAL_TIMEZONE=Europe/London
POKEVENT_EVENT_HORIZON_DAYS=90

POKEVENT_EVENT_SOURCE=pokedata
POKEVENT_SYNC_INTERVAL_MINUTES=180
POKEVENT_SYNC_GUILD_COMMANDS=true

# New-member welcomes require the Discord Developer Portal "Server Members Intent".
# PokEvent always subscribes to member join events; each server can enable or
# disable welcome posts independently in /pokevent setup.

# Discord announcement lifecycle
POKEVENT_CREATE_EVENT_THREADS=true
POKEVENT_EVENT_DEFAULT_DURATION_HOURS=8
POKEVENT_EVENT_CLEANUP_GRACE_HOURS=2

# Docker PostgreSQL
POSTGRES_DB=pokevent
POSTGRES_USER=pokevent
POSTGRES_PASSWORD=change-me
